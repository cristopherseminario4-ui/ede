# Mercado Pago (credenciales de PRUEBA para local). Sin esto, el checkout corre en modo demo (solo fuera de producción).
MP_ACCESS_TOKEN=
# Secreto de firma de webhooks (Mercado Pago > Tus integraciones > Webhooks). Si se define, se exige x-signature.
MP_WEBHOOK_SECRET=
# URL base pública de la web
BASE_URL=http://localhost:3100
# Panel interno: clave y ruta secreta (en producción /admin da 404; se entra por /<ADMIN_PATH>)
ADMIN_PASSWORD=
ADMIN_PATH=
# Sistema Django (puerta/QR/correo/WhatsApp). Si se dejan vacíos, no se sincroniza.
DJANGO_API_URL=
DJANGO_API_KEY=
DJANGO_EVENTO_ID=1
DJANGO_TARIFAS={"emprendedor":"EMPRENDEDOR","vip":"VIP","empresarial":"FULL ACCESS"}
# Correo desde la plataforma (comprobantes). Proveedor SMTP: SendGrid, Gmail con clave de aplicación, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Secreto para firmar las sesiones de contabilidad (obligatorio en producción; cadena larga y aleatoria)
SESSION_SECRET=
# IP real detrás del proxy (cf-connecting-ip / x-vercel-forwarded-for / x-real-ip)
TRUSTED_IP_HEADER=
# Tope de ventas manuales por asesor en 24 h
ADVISOR_DAILY_MAX=40
# Copia de vouchers y comprobantes a Drive (flujo n8n "EDE 2.0 · Copiar voucher/comprobante a Drive")
N8N_DRIVE_URL=
N8N_DRIVE_TOKEN=
# Solo pruebas: permite el modo demo (pago simulado) aunque NODE_ENV=production
ALLOW_DEMO=
