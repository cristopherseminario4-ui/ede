# Mercado Pago (credenciales de PRUEBA para local). Sin esto, el checkout corre en modo demo (solo fuera de producción).
MP_ACCESS_TOKEN=
# Secreto de firma de webhooks (Mercado Pago > Tus integraciones > Webhooks). Si se define, se exige x-signature.
MP_WEBHOOK_SECRET=
# URL base pública de la web
BASE_URL=http://localhost:3100
# Panel interno: clave y ruta secreta (en producción /admin da 404; se entra por /<ADMIN_PATH>)
ADMIN_PASSWORD=
ADMIN_PATH=
# Sistema Django (puerta/QR/correo/WhatsApp). Si se dejan vacíos, no se sincroniza.
DJANGO_API_URL=
DJANGO_API_KEY=
DJANGO_EVENTO_ID=1
DJANGO_TARIFAS={"emprendedor":"EMPRENDEDOR","vip":"VIP","empresarial":"EMPRESARIAL"}
# Solo pruebas: permite el modo demo (pago simulado) aunque NODE_ENV=production
ALLOW_DEMO=
